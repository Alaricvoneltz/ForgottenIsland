-- ==========================================================
-- ALARIC HUB - CLEAN UI LIBRARY
-- ==========================================================
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")

local AlaricLibrary = {}

function AlaricLibrary:CreateWindow(hubName)
    local gameName = "Unknown Game"
    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)

    local UI_NAME = "AlaricCustomLibrary"
    local targetParent = pcall(function() return CoreGui.Name end) and CoreGui or game.Players.LocalPlayer:WaitForChild("PlayerGui")
    if targetParent:FindFirstChild(UI_NAME) then
        targetParent[UI_NAME]:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = UI_NAME
    ScreenGui.Parent = targetParent
    ScreenGui.ResetOnSpawn = false

    -- Fungsi Draggable Universal
    local function MakeDraggable(dragArea, objectToMove)
        local dragging, dragInput, dragStart, startPos
        dragArea.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = objectToMove.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        dragArea.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                objectToMove.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- Tombol Open (Teks: Alaric)
    local OpenButton = Instance.new("TextButton")
    OpenButton.Parent = ScreenGui
    OpenButton.Size = UDim2.new(0, 70, 0, 35)
    OpenButton.Position = UDim2.new(0, 20, 0.5, -17)
    OpenButton.BackgroundColor3 = Color3.fromRGB(15, 30, 75)
    OpenButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    OpenButton.Text = "Alaric"
    OpenButton.Font = Enum.Font.GothamBold
    OpenButton.TextSize = 13
    OpenButton.Visible = false
    Instance.new("UICorner", OpenButton).CornerRadius = UDim.new(0, 6)
    MakeDraggable(OpenButton, OpenButton)

    -- Bingkai Utama (Biru Tua)
    local MainOuter = Instance.new("Frame")
    MainOuter.Parent = ScreenGui
    MainOuter.Size = UDim2.new(0, 520, 0, 310)
    MainOuter.Position = UDim2.new(0.5, -260, 0.5, -155)
    MainOuter.BackgroundColor3 = Color3.fromRGB(15, 30, 75)
    MainOuter.BorderSizePixel = 0
    MainOuter.Active = true
    Instance.new("UICorner", MainOuter).CornerRadius = UDim.new(0, 8)
    MakeDraggable(MainOuter, MainOuter)

    -- Lapisan Tengah (Abu-abu Gelap)
    local MainMiddle = Instance.new("Frame")
    MainMiddle.Parent = MainOuter
    MainMiddle.Size = UDim2.new(1, -12, 1, -12)
    MainMiddle.Position = UDim2.new(0, 6, 0, 6)
    MainMiddle.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    Instance.new("UICorner", MainMiddle).CornerRadius = UDim.new(0, 6)

    -- Sidebar Kiri
    local Sidebar = Instance.new("Frame")
    Sidebar.Parent = MainMiddle
    Sidebar.Size = UDim2.new(0, 140, 1, 0)
    Sidebar.BackgroundTransparency = 1

    local Title = Instance.new("TextLabel")
    Title.Parent = Sidebar
    Title.Size = UDim2.new(1, -10, 0, 40)
    Title.Position = UDim2.new(0, 5, 0, 5)
    Title.BackgroundTransparency = 1
    Title.Text = (hubName or "AlaricHub") .. "\n<font size='10'>"..string.sub(gameName, 1, 20).."</font>"
    Title.RichText = true
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 13

    local TabContainer = Instance.new("ScrollingFrame")
    TabContainer.Parent = Sidebar
    TabContainer.Size = UDim2.new(1, 0, 1, -55)
    TabContainer.Position = UDim2.new(0, 0, 0, 50)
    TabContainer.BackgroundTransparency = 1
    TabContainer.ScrollBarThickness = 2
    local TabListLayout = Instance.new("UIListLayout", TabContainer)
    TabListLayout.Padding = UDim.new(0, 5)
    TabListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    -- Area Konten Kanan (Hitam)
    local ContentArea = Instance.new("Frame")
    ContentArea.Parent = MainMiddle
    ContentArea.Size = UDim2.new(1, -150, 1, -10)
    ContentArea.Position = UDim2.new(0, 145, 0, 5)
    ContentArea.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    Instance.new("UICorner", ContentArea).CornerRadius = UDim.new(0, 6)

    -- Kontrol Pojok Atas (Hide & Close)
    local TopRightControls = Instance.new("Frame")
    TopRightControls.Parent = MainMiddle
    TopRightControls.Size = UDim2.new(0, 70, 0, 30)
    TopRightControls.Position = UDim2.new(1, -75, 0, 5)
    TopRightControls.BackgroundTransparency = 1
    TopRightControls.ZIndex = 10

    local HideBtn = Instance.new("TextButton", TopRightControls)
    HideBtn.Size = UDim2.new(0, 30, 0, 30)
    HideBtn.BackgroundTransparency = 1
    HideBtn.Text = "-"
    HideBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    HideBtn.Font = Enum.Font.GothamBold
    HideBtn.TextSize = 14

    local CloseBtn = Instance.new("TextButton", TopRightControls)
    CloseBtn.Size = UDim2.new(0, 30, 0, 30)
    CloseBtn.Position = UDim2.new(0, 35, 0, 0)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 14

    HideBtn.MouseButton1Click:Connect(function() MainOuter.Visible = false; OpenButton.Visible = true end)
    OpenButton.MouseButton1Click:Connect(function() MainOuter.Visible = true; OpenButton.Visible = false end)
    CloseBtn.MouseButton1Click:Connect(function() ScreenGui:Destroy() end)

    local WindowObj = {}
    local isFirstTab = true

    function WindowObj:CreateTab(tabName)
        local TabBtn = Instance.new("TextButton", TabContainer)
        TabBtn.Size = UDim2.new(0, 120, 0, 32)
        TabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        TabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        TabBtn.Text = tabName
        TabBtn.Font = Enum.Font.GothamSemibold
        TabBtn.TextSize = 12
        Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 4)

        local Page = Instance.new("ScrollingFrame", ContentArea)
        Page.Size = UDim2.new(1, 0, 1, -35)
        Page.Position = UDim2.new(0, 0, 0, 35)
        Page.BackgroundTransparency = 1
        Page.ScrollBarThickness = 3
        Page.Visible = false
        
        local PageLayout = Instance.new("UIListLayout", Page)
        PageLayout.Padding = UDim.new(0, 8)
        PageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        PageLayout.SortOrder = Enum.SortOrder.LayoutOrder
        Instance.new("UIPadding", Page).PaddingTop = UDim.new(0, 5)

        if isFirstTab then
            Page.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(15, 30, 75)
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            isFirstTab = false
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, child in pairs(ContentArea:GetChildren()) do
                if child:IsA("ScrollingFrame") then child.Visible = false end
            end
            for _, btn in pairs(TabContainer:GetChildren()) do
                if btn:IsA("TextButton") then 
                    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25) 
                    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
            Page.Visible = true
            TabBtn.BackgroundColor3 = Color3.fromRGB(15, 30, 75)
            TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        local TabObj = {}

        -- Tombol Biasa
        function TabObj:CreateButton(name, callback)
            local Btn = Instance.new("TextButton", Page)
            Btn.Size = UDim2.new(0, 330, 0, 35)
            Btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Text = name
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = 13
            Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 4)
            Btn.MouseButton1Click:Connect(function()
                pcall(callback)
            end)
        end

        -- Toggle (Tema Hitam & Putih)
        function TabObj:CreateToggle(name, callback)
            local ToggleFrame = Instance.new("Frame", Page)
            ToggleFrame.Size = UDim2.new(0, 330, 0, 35)
            ToggleFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 4)

            local ToggleLabel = Instance.new("TextLabel", ToggleFrame)
            ToggleLabel.Size = UDim2.new(1, -60, 1, 0)
            ToggleLabel.Position = UDim2.new(0, 10, 0, 0)
            ToggleLabel.BackgroundTransparency = 1
            ToggleLabel.Text = name
            ToggleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleLabel.Font = Enum.Font.Gotham
            ToggleLabel.TextSize = 13
            ToggleLabel.TextXAlignment = Enum.TextXAlignment.Left

            local ToggleBtn = Instance.new("TextButton", ToggleFrame)
            ToggleBtn.Size = UDim2.new(0, 45, 0, 24)
            ToggleBtn.Position = UDim2.new(1, -55, 0, 5.5)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20) -- Hitam (Off)
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            ToggleBtn.Text = "OFF"
            ToggleBtn.Font = Enum.Font.GothamBold
            ToggleBtn.TextSize = 10
            Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(0, 4)

            local isToggled = false
            ToggleBtn.MouseButton1Click:Connect(function()
                isToggled = not isToggled
                if isToggled then
                    ToggleBtn.BackgroundColor3 = Color3.fromRGB(240, 240, 240) -- Putih (On)
                    ToggleBtn.TextColor3 = Color3.fromRGB(20, 20, 20)
                    ToggleBtn.Text = "ON"
                else
                    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20) -- Hitam (Off)
                    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    ToggleBtn.Text = "OFF"
                end
                pcall(function() callback(isToggled) end)
            end)
        end

        -- Input Angka
        function TabObj:CreateNumberInput(placeholder, callback)
            local NumInput = Instance.new("TextBox", Page)
            NumInput.Size = UDim2.new(0, 330, 0, 35)
            NumInput.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            NumInput.TextColor3 = Color3.fromRGB(255, 255, 255)
            NumInput.PlaceholderText = placeholder or "Masukkan Angka"
            NumInput.Font = Enum.Font.Gotham
            NumInput.TextSize = 13
            Instance.new("UICorner", NumInput).CornerRadius = UDim.new(0, 4)
            NumInput:GetPropertyChangedSignal("Text"):Connect(function()
                NumInput.Text = NumInput.Text:gsub("%D", "")
                pcall(function() callback(tonumber(NumInput.Text) or 0) end)
            end)
        end

        -- Input Teks (Auto Wrap)
        function TabObj:CreateTextInput(placeholder, callback)
            local TxtInput = Instance.new("TextBox", Page)
            TxtInput.Size = UDim2.new(0, 330, 0, 60)
            TxtInput.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            TxtInput.TextColor3 = Color3.fromRGB(255, 255, 255)
            TxtInput.PlaceholderText = placeholder or "Masukkan Teks"
            TxtInput.Font = Enum.Font.Gotham
            TxtInput.TextSize = 13
            TxtInput.TextWrapped = true
            TxtInput.TextYAlignment = Enum.TextYAlignment.Top
            TxtInput.TextXAlignment = Enum.TextXAlignment.Left
            TxtInput.ClearTextOnFocus = false
            Instance.new("UICorner", TxtInput).CornerRadius = UDim.new(0, 4)
            
            local Pad = Instance.new("UIPadding", TxtInput)
            Pad.PaddingTop = UDim.new(0, 8) 
            Pad.PaddingLeft = UDim.new(0, 8)

            TxtInput.FocusLost:Connect(function()
                pcall(function() callback(TxtInput.Text) end)
            end)
        end

        -- Dropdown
        function TabObj:CreateDropdown(name, options, callback)
            local DropdownBtn = Instance.new("TextButton", Page)
            DropdownBtn.Size = UDim2.new(0, 330, 0, 35)
            DropdownBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            DropdownBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            DropdownBtn.Text = name .. ": - "
            DropdownBtn.Font = Enum.Font.GothamBold
            DropdownBtn.TextSize = 13
            Instance.new("UICorner", DropdownBtn).CornerRadius = UDim.new(0, 4)

            local DropdownList = Instance.new("Frame", Page)
            DropdownList.Size = UDim2.new(0, 330, 0, #options * 35)
            DropdownList.BackgroundTransparency = 1
            DropdownList.Visible = false
            local DropLayout = Instance.new("UIListLayout", DropdownList)
            DropLayout.Padding = UDim.new(0, 5)

            for _, opt in pairs(options) do
                local optBtn = Instance.new("TextButton", DropdownList)
                optBtn.Size = UDim2.new(1, 0, 0, 30)
                optBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
                optBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
                optBtn.Text = opt
                Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 4)
                optBtn.MouseButton1Click:Connect(function()
                    DropdownBtn.Text = name .. ": " .. opt
                    DropdownList.Visible = false
                    pcall(function() callback(opt) end)
                end)
            end

            DropdownBtn.MouseButton1Click:Connect(function()
                DropdownList.Visible = not DropdownList.Visible
            end)
        end

        return TabObj
    end

    return WindowObj
end

return AlaricLibrary
